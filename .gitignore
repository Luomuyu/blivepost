# Python
__pycache__
.mypy_cache
.pytest_cache
*.pyc
*.egg-info
build/
dist/
.venv

# IDE/编辑器
.idea
.vscode
.DS_Store
.dockerignore

# 敏感与本地配置（含app_secret，严禁提交）
.env
config.yaml

# 运行时产物
data/
logs/
exports/
_vendor/
WheelTest/
unknowncmd.txt
dynamic_*.txt
*.log

# 临时脚本（审查/装配用的下划线前缀脚本）
_*.py

# 旧代码归档
oldsrc
# 面板运维脚本产物（panel_id含真实凭证信息，任何副本都不入库）
scripts/panel_ids*.json

*.whl
# playwright chromium内核（运行目录本地安装）
ms-playwright/

# .dockerignore 仅本地开发用（隔离WheelTest等本地产物），不入库——
# 正式镜像构建从git拉取干净代码后构建，无需该文件
.dockerignore

# markdown仅保留用户可见两份入库，开发文档（PROJECT/REVIEW/HANDOVER/ROADMAP）本地留存
*.md
!README.md
!THIRD_PARTY_NOTICES.md
